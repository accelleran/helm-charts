#!/bin/bash
#
# Open a GitHub issue for each private ghcr.io/<org>/charts/<name> package.
# Close that issue if the package is later public. A closed issue is left
# alone so "should stay private" is just closing it.
#
# DRY_RUN=1 prints actions without creating or closing issues.

set -eu -o pipefail

if ! command -v gh >/dev/null ; then
    echo "gh is required" 1>&2
    exit 1
fi

if ! command -v jq >/dev/null ; then
    echo "jq is required" 1>&2
    exit 1
fi

REPO="${GITHUB_REPOSITORY:-accelleran/helm-charts}"
ORG="${REPO%%/*}"
LABEL="${GHCR_VISIBILITY_LABEL:-ghcr-visibility}"
DRY_RUN="${DRY_RUN:-}"

issue_title() {
    printf 'GHCR package %s is private' "$1"
}

ensure_label() {
    if gh api "repos/${REPO}/labels/${LABEL}" >/dev/null 2>&1 ; then
        return
    fi
    if [[ -n "${DRY_RUN}" ]] ; then
        echo "Would create label ${LABEL}"
        return
    fi
    gh label create "${LABEL}" --repo "${REPO}" --description "GHCR chart package is private" --color D4C5F9
}

load_issues() {
    gh issue list --repo "${REPO}" --state all --limit 1000 \
        --search 'is:issue in:title "GHCR package"' \
        --json number,state,title
}

packages=$(gh api --paginate "orgs/${ORG}/packages?package_type=container&per_page=100" \
    | jq -c --arg repo "${REPO}" '
        .[]
        | select(.package_type == "container")
        | select(.name | startswith("charts/"))
        | select(.repository.full_name == $repo)
        | {name, visibility, html_url}
    ')

if [[ -z "${packages}" ]] ; then
    echo "No GHCR packages named charts/* linked to ${REPO}"
    exit 0
fi

ensure_label

issues_json=$(load_issues)

created=0
closed=0
skipped=0

while IFS= read -r pkg ; do
    [[ -z "${pkg}" ]] && continue
    name=$(printf '%s' "${pkg}" | jq -r .name)
    visibility=$(printf '%s' "${pkg}" | jq -r .visibility)
    html_url=$(printf '%s' "${pkg}" | jq -r .html_url)
    settings_url="https://github.com/orgs/${ORG}/packages/container/${name//\//%2F}/settings#:~:text=Change%20package%20visibility"
    title=$(issue_title "${name}")
    open_number=$(printf '%s' "${issues_json}" | jq -r --arg title "${title}" '[.[] | select(.title == $title and .state == "OPEN") | .number] | first // empty')
    any_number=$(printf '%s' "${issues_json}" | jq -r --arg title "${title}" '[.[] | select(.title == $title) | .number] | first // empty')

    if [[ "${visibility}" == "public" ]] ; then
        if [[ -n "${open_number}" ]] ; then
            echo "Closing #${open_number}: ${name} is public"
            if [[ -z "${DRY_RUN}" ]] ; then
                gh issue close "${open_number}" --repo "${REPO}" --comment "This package is now public."
            fi
            closed=$((closed + 1))
        fi
        continue
    fi

    if [[ "${visibility}" != "private" && "${visibility}" != "internal" ]] ; then
        echo "Skipping ${name}: unexpected visibility ${visibility}"
        continue
    fi

    if [[ -n "${open_number}" ]] ; then
        echo "Already tracking ${name} in #${open_number}"
        skipped=$((skipped + 1))
        continue
    fi

    if [[ -n "${any_number}" ]] ; then
        echo "Skipping ${name}: #${any_number} was closed (leave private or reopen)"
        skipped=$((skipped + 1))
        continue
    fi

    echo "Opening issue for ${name} (${visibility})"
    if [[ -z "${DRY_RUN}" ]] ; then
        gh issue create --repo "${REPO}" --label "${LABEL}" --title "${title}" --body "$(cat <<EOF
The GHCR package [\`${name}\`](${html_url}) is **${visibility}**.

GitHub does not provide an API to change package visibility. Either:

- Make it public: [Change package visibility](${settings_url})
- Leave it private: close this issue. Later runs will not open a new one unless you reopen it.

EOF
)"
    fi
    created=$((created + 1))
done < <(printf '%s\n' "${packages}")

echo "Created ${created}, closed ${closed}, skipped ${skipped}"
