#!/bin/bash

set -eu -o pipefail

# shellcheck source=bin/external-charts-lib.sh
source "$(dirname "$(realpath "$0")")/external-charts-lib.sh"

PACKAGE_PATH="${CR_PACKAGE_PATH:-${GIT_ROOT}/.cr-release-packages}"

function fatal() {
    error "${@}"
    exit 1
}

function error() {
    echo "${1}" 1>&2
}

if [[ ! "$(yq --version)" =~ .*mikefarah/yq.* ]]; then
    fatal "Make sure to install mikefarah/yq"
fi

mkdir -p "${PACKAGE_PATH}"

exit_status=0

while IFS= read -r ext; do
    chart_name="$(yq '.name' "$ext")"
    chart_alias="$(yq '.alias // ""' "$ext")"
    chart_repository="$(yq '.repository' "$ext")"
    chart_version="$(yq '.version' "$ext")"

    if [ -n "$chart_alias" ] ; then
        error "alias is not supported for external charts (would require re-packaging): $ext"
        exit_status=1
        continue
    fi

    if [[ "$chart_repository" != oci://* ]] ; then
        error "Only OCI repositories are supported for external charts"
        exit_status=1
        continue
    fi

    echo "Pulling $chart_repository/$chart_name version $chart_version"
    if ! helm pull "$chart_repository/$chart_name" --version "$chart_version" --destination "$PACKAGE_PATH" ; then
        error "Failed to pull $chart_repository/$chart_name:$chart_version"
        exit_status=1
        continue
    fi
done < <(list_external_chart_files)

exit "$exit_status"
