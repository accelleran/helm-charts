#!/bin/bash
#
# Move charts/<name> to deprecated/<name> and mark it deprecated.
# Release-please component and package-name stay the same so tags continue.

set -eu -o pipefail

# shellcheck source=bin/chart-lifecycle-lib.sh
source "$(dirname "$(realpath "$0")")/chart-lifecycle-lib.sh"

function usage() {
    cat <<'EOF'
Usage: deprecate-chart [-n] [-s successor] <chart>

Move charts/<chart> to deprecated/<chart> and mark the chart deprecated.

The release-please package key is renamed from charts/<chart> to
deprecated/<chart>. component and package-name are left unchanged, so
release tags stay continuous.

Chart.yaml gets deprecated: true and a description prefix of "DEPRECATED -".
templates/NOTES.txt gains a DEPRECATED banner. -s names the successor in
that banner.

Options:
  -n, --dry-run           Show what would change and do not touch the tree
  -s, --successor <name>  Successor chart named in templates/NOTES.txt
  -h, --help              Show this help

Changes are staged and left uncommitted.
EOF
}

dry_run=0
successor=""
chart=""

while [[ $# -gt 0 ]]; do
    case "${1}" in
        -h|--help)
            usage
            exit 0
            ;;
        -n|--dry-run)
            dry_run=1
            shift
            ;;
        -s|--successor)
            [[ $# -ge 2 ]] || error "--successor requires a chart name"
            successor="${2}"
            shift 2
            ;;
        --successor=*)
            successor="${1#*=}"
            [[ -n "${successor}" ]] || error "--successor requires a chart name"
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            error "unknown option: ${1}"
            ;;
        *)
            [[ -z "${chart}" ]] || error "unexpected argument: ${1}"
            chart="${1}"
            shift
            ;;
    esac
done

if [[ $# -gt 0 ]]; then
    [[ -z "${chart}" ]] || error "unexpected argument: ${1}"
    chart="${1}"
    shift
    [[ $# -eq 0 ]] || error "unexpected argument: ${1}"
fi

[[ -n "${chart}" ]] || error "chart name is required (see --help)"

require_tools
validate_chart_name "${chart}"
if [[ -n "${successor}" ]]; then
    validate_chart_name "${successor}"
    if [[ "${successor}" == "${chart}" ]]; then
        error "successor must be a different chart"
    fi
fi

location="$(chart_location "${chart}")"
case "${location}" in
    charts)
        ;;
    deprecated)
        error "${chart} is already in deprecated/"
        ;;
    archived)
        error "${chart} is archived. Move it back to charts/ before deprecating it."
        ;;
    external)
        refuse_external_chart "${chart}"
        ;;
    *)
        error "${chart} was not found in charts/, deprecated/, or archived/"
        ;;
esac

require_directory_matches_chart_name "${chart}" "charts"
require_release_please_entry "charts/${chart}"
require_release_please_destination_free "deprecated/${chart}"
if [[ -e "${GIT_ROOT}/deprecated/${chart}" ]]; then
    error "deprecated/${chart} already exists"
fi
successor_warning "${successor}"

from_key="charts/${chart}"
to_key="deprecated/${chart}"

echo "move ${from_key} -> ${to_key}"
echo "release-please $(release_please_summary "${from_key}")"
if [[ -n "${successor}" ]]; then
    echo "NOTES.txt successor: ${successor}"
else
    echo "NOTES.txt successor: none"
fi

if [[ "${dry_run}" -eq 1 ]]; then
    echo "Dry run: no files were changed."
    exit 0
fi

mark_chart_yaml_deprecated "${GIT_ROOT}/charts/${chart}/Chart.yaml" "${chart}"
echo "Chart.yaml: set deprecated: true and prefixed description with DEPRECATED -"
write_notes_banner "${GIT_ROOT}/charts/${chart}/templates/NOTES.txt" "${successor}"

git -C "${GIT_ROOT}" mv "charts/${chart}" "deprecated/${chart}"
rename_release_please_entry "${from_key}" "${to_key}"
git -C "${GIT_ROOT}" add -- \
    "etc/release-please-config.json" \
    "etc/.release-please-manifest.json" \
    "deprecated/${chart}"

verify_deprecated_chart "${chart}"
show_staged_status "${chart}"
