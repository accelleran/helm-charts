{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>accelleran/renovate-config",
    ":semanticCommitTypeAll(fix)",
    ":automergeMinor"
  ],
  "reviewers": [
    "team:dRAX"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s?renovate: image=(?<depName>.*?)( versioning=(?<versioning>.*?))?( extract_version=(?<extractVersion>.*?))?\\s?appVersion:\\s?\"?(?<currentValue>[\\w+\\.\\-]*)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/)External\\.yaml$/"
      ],
      "matchStrings": [
        "name:\\s+\"?(?<chartName>.*?)\"?\\s+(.*\\s)?repository:\\s+\"?oci://(?<registryRef>.*?)\"?\\s+(.*\\s)?version:\\s+\"?(?<currentValue>[\\w\\.\\-]*)\"?"
      ],
      "packageNameTemplate": "{{registryRef}}/{{chartName}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/)values\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s?renovate:( versioning=(?<versioning>.*?))?( extract_version=(?<extractVersion>.*?))?\\s+image:\\s?\"?(?<depName>[^:]*?):(?<currentValue>[\\w+\\.\\-]*)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "helm",
      "managerFilePatterns": [
        "/(^|/)values\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s?renovate: repository=(?<registryUrl>.*?) chart=(?<depName>.*?)\\s?[\\w\\-]*[vV]ersion:\\s?\"?(?<currentValue>[\\w\\.\\-]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/(^|/)helm-charts\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s?renovate: github_repository=(?<depName>.*?)( versioning=(?<versioning>.*?))?( extract_version=(?<extractVersion>.*?))?\\s*[\\w\\-]*_version:\\s?\"?(?<currentValue>[\\w+\\.\\-]*)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/(^|/).+\\.sh$/"
      ],
      "matchStrings": [
        "#\\s?renovate: github_repository=(?<depName>.*?)( versioning=(?<versioning>.*?))?( extract_version=(?<extractVersion>.*?))?\\s*(export\\s+)?[\\w\\-]*_[vV][eE][rR][sS][iI][oO][nN]=\"?(?<currentValue>[\\w+\\.\\-]*)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Disable org docker:pinDigests here. Charts often leave image.tag empty so templates fall back to Chart.AppVersion and render repository:tag (colon). Digest pinning would rewrite those to digest-only values and break image refs; appVersion must stay a plain version, not tag@digest. Revisit when tags are always explicit and helpers support digests.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Automerge external chart updates",
      "automerge": true,
      "matchFileNames": [
        "/External\\.yaml/"
      ]
    },
    {
      "description": "Use loose versioning for acc-generic-img to allow k8s suffix changes",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "accelleran/acc-generic-img"
      ],
      "versioning": "loose"
    }
  ]
}
